generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DIRECT_URL")
}

model Almacen {
  id               Int                @id @default(autoincrement())
  nombre           String
  ubicacion        String?
  descripcion      String?
  unidadId         Int?
  unidad           Unidad?            @relation(fields: [unidadId], references: [id])
  movimientos      Movimiento[]
  ordenesEntrega   OrdenEntrega[]
  ordenesVolumen   ItemOrdenVolumen[]
  productos        Producto[]
  trasladosDestino Traslado[]         @relation("TrasladoDestino")
  trasladosOrigen  Traslado[]         @relation("TrasladoOrigen")
}

model Unidad {
  id           Int          @id @default(autoincrement())
  nombre       String       @unique
  descripcion  String?
  almacenes    Almacen[]
  trabajadores Trabajador[]
}

model Rol {
  id           Int          @id @default(autoincrement())
  nombre       String       @unique
  descripcion  String?
  permisos     Json
  trabajadores Trabajador[]
}

model Trabajador {
  id             Int            @id @default(autoincrement())
  dni            String         @unique
  nombres        String
  apellidos      String
  email          String         @unique
  telefono       String
  unidadId       Int
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  rolId          Int
  password       String?
  logs           Log[]
  ordenesEntrega OrdenEntrega[]
  ordenesVolumen OrdenVolumen[]
  rol            Rol            @relation(fields: [rolId], references: [id])
  unidad         Unidad         @relation(fields: [unidadId], references: [id])
  traslados      Traslado[]
  solicitudes    Solicitud[]
}

model Producto {
  id             Int                @id @default(autoincrement())
  codigo         String             @unique
  nombre         String
  descripcion    String?
  almacenId      Int?
  movimientos    Movimiento[]
  ordenesEntrega OrdenEntrega[]
  ordenesVolumen ItemOrdenVolumen[]
  almacen        Almacen?           @relation(fields: [almacenId], references: [id])
  traslados      Traslado[]
}

model Movimiento {
  id             Int                  @id @default(autoincrement())
  tipo           String
  fecha          DateTime
  cantidad       Int
  precioUnitario Float?
  motivo         String
  productoId     Int
  almacenId      Int
  ordenEntregaId Int?
  factura        String?
  almacen        Almacen              @relation(fields: [almacenId], references: [id])
  ordenEntrega   OrdenEntrega?        @relation(fields: [ordenEntregaId], references: [id])
  producto       Producto             @relation(fields: [productoId], references: [id])
  constancia     ConstanciaRecepcion?
}

model OrdenEntrega {
  id              Int          @id @default(autoincrement())
  numeroTicket    String       @unique
  fechaSolicitud  DateTime     @default(now())
  fechaAprobacion DateTime?
  estado          String
  cantidad        Int
  motivo          String
  observaciones   String?
  trabajadorId    Int
  productoId      Int
  almacenId       Int
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  movimientos     Movimiento[]
  almacen         Almacen      @relation(fields: [almacenId], references: [id])
  producto        Producto     @relation(fields: [productoId], references: [id])
  trabajador      Trabajador   @relation(fields: [trabajadorId], references: [id])
}

model OrdenVolumen {
  id              Int                @id @default(autoincrement())
  numeroTicket    String             @unique
  fechaSolicitud  DateTime           @default(now())
  fechaAprobacion DateTime?
  estado          String             @default("pendiente")
  motivo          String
  observaciones   String?
  trabajadorId    Int
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  trabajador      Trabajador         @relation(fields: [trabajadorId], references: [id])
  items           ItemOrdenVolumen[]
}

model ItemOrdenVolumen {
  id         Int          @id @default(autoincrement())
  ordenId    Int
  productoId Int
  almacenId  Int
  cantidad   Int
  orden      OrdenVolumen @relation(fields: [ordenId], references: [id])
  producto   Producto     @relation(fields: [productoId], references: [id])
  almacen    Almacen      @relation(fields: [almacenId], references: [id])
}

model Traslado {
  id               Int        @id @default(autoincrement())
  numeroGuia       String     @unique
  fechaSolicitud   DateTime   @default(now())
  fechaAprobacion  DateTime?
  estado           String
  cantidad         Int
  observaciones    String?
  productoId       Int
  almacenOrigenId  Int
  almacenDestinoId Int
  trabajadorId     Int
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  almacenDestino   Almacen    @relation("TrasladoDestino", fields: [almacenDestinoId], references: [id])
  almacenOrigen    Almacen    @relation("TrasladoOrigen", fields: [almacenOrigenId], references: [id])
  producto         Producto   @relation(fields: [productoId], references: [id])
  trabajador       Trabajador @relation(fields: [trabajadorId], references: [id])
}

model Log {
  id        Int         @id @default(autoincrement())
  usuarioId Int?
  accion    String
  entidad   String
  entidadId Int?
  detalles  String?
  fecha     DateTime    @default(now())
  usuario   Trabajador? @relation(fields: [usuarioId], references: [id])
}

model Notificacion {
  id        Int      @id @default(autoincrement())
  tipo      String
  mensaje   String
  leida     Boolean  @default(false)
  origen    String
  datos     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Segmento {
  id                 Int                          @id @default(autoincrement())
  nombre             String                       @unique
  descripcion        String?
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt
  proveedores        Proveedor[]
  registrationTokens ProveedorRegistrationToken[]

  @@map("segmentos")
}

model Proveedor {
  id           Int                   @id @default(autoincrement())
  ruc          String                @unique
  nombre       String
  telefono     String?
  email        String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  segmentoId   Int
  detalles     String?
  mesesCredito Int?
  constancias  ConstanciaRecepcion[]
  segmento     Segmento              @relation(fields: [segmentoId], references: [id])

  @@map("proveedores")
}

model ConstanciaRecepcion {
  id                  Int        @id @default(autoincrement())
  numero              String     @unique @default(cuid())
  fecha               DateTime   @default(now())
  horaEntrada         String
  descripcionProducto String
  proveedorId         Int
  numeroGuia          String?
  agenciaTransporte   String?
  numeroGuiaAgencia   String?
  observaciones       String?
  movimientoId        Int        @unique
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  movimiento          Movimiento @relation(fields: [movimientoId], references: [id])
  proveedor           Proveedor  @relation(fields: [proveedorId], references: [id])

  @@map("constancias_recepcion")
}

model Solicitud {
  id        Int        @id @default(autoincrement())
  usuarioId Int
  asunto    String
  elementos Json
  estado    String     @default("PENDIENTE")
  motivo    String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  usuario   Trabajador @relation(fields: [usuarioId], references: [id])

  @@map("solicitudes")
}

model ProveedorRegistrationToken {
  id         Int       @id @default(autoincrement())
  token      String    @unique
  segmentoId Int? // Segmento predefinido (opcional)
  expiresAt  DateTime // Fecha de expiración
  used       Boolean   @default(false) // Si ya fue usado
  usedAt     DateTime? // Cuándo fue usado
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  // Relaciones
  segmento Segmento? @relation(fields: [segmentoId], references: [id])

  @@map("proveedor_registration_tokens")
}
